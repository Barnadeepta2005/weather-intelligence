# Data.gov.in Open Government Data (OGD) API Key
# Used server-side for official India CPCB CAAQMS ground station telemetry.
# Free registration at: https://data.gov.in/
# If left unset, the application gracefully falls back to Open-Meteo CAMS atmospheric model.
DATA_GOV_IN_API_KEY=your_data_gov_in_api_key_here
